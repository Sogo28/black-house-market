# Copier ce fichier en .env.local, puis remplir les valeurs.
# En local : elles s'affichent avec `npm run db:start` (ou `npx supabase status`).
# En ligne : tableau de bord Supabase > Project Settings > API Keys.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Numéro WhatsApp de la boutique : 9 chiffres, sans +221 (ex. 771234567).
NEXT_PUBLIC_SHOP_WHATSAPP=

# Clé secrète : serveur uniquement, elle ignore la RLS. Ne jamais la préfixer par NEXT_PUBLIC_.
# Utilisée à partir de l'étape 3 (enregistrement des commandes).
SUPABASE_SECRET_KEY=
